# Copy to /etc/agent-launchpad/fixed.env (root, 600) and fill in. What every fleet agent gets from the host, whatever its own file says.
OWNER_TELEGRAM_ID=
# One Claude key for the fleet: a Console API key in the company's name (docs/FLEET.md).
CLAUDE_KEY=
TZ=UTC
# The fleet's peer keys, so the agents see each other: the public keys allowed in (the fleet's and the supervisor's), and the fleet's private key.
FLEET_PEER_PUBLIC_KEYS=""
FLEET_PEER_SSH_KEY=""
